# --- Provider ---
# Base URL of the OpenAI API-compatible provider.
PROVIDER_BASE_URL=https://api.openai.com/v1

# API key (optional; some local providers don't require one).
PROVIDER_API_KEY=

# --- Models ---
TEXT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-2

# --- Generation ---
# Target seconds between consecutive successfully displayed images.
GENERATION_INTERVAL_SECONDS=10

# Maximum number of images kept in memory for the session.
MAX_IMAGES=500

# Default creativity level (mild | normal | wild).
CREATIVITY=normal

# --- Server ---
# TCP port to bind the local web server on.
PORT=8191
